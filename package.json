{
  "name": "reporte_semanal",
  "version": "2.0.0",
  "description": "Aplicación para Windows que registra el tiempo de uso de aplicaciones y envía un reporte semanal en PDF por correo.",
  "main": "dist/main.js",
  "bin": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:csharp": "powershell -Command \"Get-ChildItem csharp -Filter *.csproj -Recurse | ForEach-Object { dotnet build $_.FullName -c Release }\"",
    "build:all": "npm run build && npm run build:csharp",
    "start": "node dist/main",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts"
  },
  "keywords": [
    "productivity",
    "tracker",
    "windows",
    "report",
    "pdf",
    "csharp"
  ],
  "author": "Juanse",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "dotenv": "^17.3.1",
    "get-windows": "^9.3.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
