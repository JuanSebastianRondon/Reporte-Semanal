{
  "name": "reporte_semanal",
  "version": "2.0.3",
  "description": "Aplicación multiplataforma que registra el tiempo de uso de aplicaciones y envía un reporte semanal en PDF por correo.",
  "main": "dist/main.js",
  "bin": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deps:check": "npm outdated",
    "deps:update": "npm update --save",
    "audit": "npm audit",
    "build": "tsc",
    "build:windows": "powershell -Command \"Get-ChildItem clients/windows -Filter *.csproj -Recurse | ForEach-Object { dotnet build $_.FullName -c Release }\"",
    "copy:windows": "powershell -ExecutionPolicy Bypass -File packaging/windows/copy-binaries.ps1",
    "version:check": "node scripts/check-version.js",
    "preview:pdf": "npm run build && node scripts/preview-pdf-palettes.js",
    "build:all": "npm run build && npm run build:windows",
    "start": "node dist/main",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "npm run build && node --test \"test/*.test.js\""
  },
  "keywords": [
    "productivity",
    "tracker",
    "windows",
    "report",
    "pdf",
    "csharp"
  ],
  "author": "Juanse",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^6.1.3",
    "dotenv": "^17.4.2",
    "get-windows": "^10.0.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
